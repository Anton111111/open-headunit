<?xml version="1.0" encoding="utf-8"?>
<!-- Adds a widget, and looks like an empty favorite slot because it is the same kind of place. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_add_tile"
    android:layout_width="@dimen/home_favorites_height"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/home_favorite_slot_bg">

    <ImageView
        android:id="@+id/widget_add_icon"
        style="@style/HomeTileIcon"
        android:layout_width="@dimen/home_favorite_icon"
        android:layout_height="@dimen/home_favorite_icon"
        app:srcCompat="@drawable/ic_add_white" />

    <TextView
        android:id="@+id/widget_add_label"
        style="@style/HomeTileLabel.Wrap"
        android:text="@string/home_add_widget" />

</LinearLayout>
