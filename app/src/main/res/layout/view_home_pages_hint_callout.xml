<?xml version="1.0" encoding="utf-8"?>
<!--
    The card of the pages hint. HomePagesHintView places it, sizes its text and, when there is no
    spotlight, shows the art (the hand and ring, drawn by the hint view over it) above or beside
    the text.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_pages_hint_callout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/home_hint_callout_bg"
    android:padding="@dimen/home_hint_callout_padding">

    <LinearLayout
        android:id="@+id/home_pages_hint_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <View
            android:id="@+id/home_pages_hint_art"
            android:layout_width="@dimen/home_hint_art"
            android:layout_height="@dimen/home_hint_art"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_pages_hint_texts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_pages_hint_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_pages_hint_title"
                android:textColor="@color/home_hint_title"
                android:textSize="@dimen/home_hint_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_pages_hint_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_pages_hint_body"
                android:textColor="@color/home_hint_body"
                android:textSize="@dimen/home_hint_body" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_pages_hint_got_it"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_hint_button_height"
        android:layout_gravity="end"
        android:layout_marginTop="20dp"
        android:minWidth="120dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:text="@string/home_pages_hint_got_it"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/home_hint_button"
        app:cornerRadius="26dp"
        app:strokeColor="@color/home_hint_button_stroke"
        app:strokeWidth="3dp" />

</LinearLayout>
